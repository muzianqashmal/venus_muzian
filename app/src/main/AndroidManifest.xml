<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="venus_muzian"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Venus_muzian">

        <!-- Pertemuan 3 -->
        <activity
            android:name=".pertemuan_3.ThirdActivity"
            android:exported="false"
            android:label="venus_muzian"
            android:theme="@style/Theme.Venus_muzian"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pertemuan 2 -->
        <activity
            android:name=".pertemuan_2.SecondActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="venus_muzian"
            android:theme="@style/Theme.Venus_muzian"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pertemuan 3 -->
        <activity
            android:name=".pertemuan_3.ThirdResultActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pertemuan 4 -->
        <activity
            android:name=".pertemuan_4.FourthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pertemuan 5 -->
        <activity
            android:name=".pertemuan_5.FifthActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".pertemuan_5.WebViewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Login -->
        <activity
            android:name=".AuthActivity"
            android:exported="false"
            android:label="venus_muzian"
            android:theme="@style/Theme.Venus_muzian"
            android:windowSoftInputMode="adjustResize" />

        <!-- Splash Screen menjadi halaman pertama -->
        <activity
            android:name=".SplashScreenActivity"
            android:exported="true"
            android:label="venus_muzian"
            android:theme="@style/Theme.Venus_muzian"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>